{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Venue knowledge pack",
  "type": "object",
  "required": ["venue", "entries"],
  "properties": {
    "venue": {"type": "string", "description": "Display name of the shrine or venue"},
    "id": {"type": "string"},
    "kind": {"type": "string"},
    "simulated": {"type": "boolean"},
    "disclaimer": {"type": "string"},
    "languages": {"type": "array", "items": {"type": "string"}},
    "stops": {"type": "array", "items": {"type": "object", "required": ["id", "name"],
              "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "topic", "triggers", "answer"],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string", "description": "Short title, also shown in the 'you can ask about' list"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "triggers": {"type": "array", "items": {"type": "string"},
                       "description": "Words people say: English plus native-script and romanised words in each language"},
          "answer": {"type": "string", "description": "Short factual English answer. The assistant phrases and translates it."},
          "where": {"type": "string", "description": "A stop id from 'stops', or 'all'"},
          "example_questions": {"type": "array", "items": {"type": "string"}},
          "simulated": {"type": "boolean"}
        }
      }
    }
  }
}
